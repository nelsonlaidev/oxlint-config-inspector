  "license": "MIT",
  "author": "Nelson Lai <me@nelsonlai.dev> (https://github.com/nelsonlaidev/)",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:builtin-rule-docs": "tsx scripts/generate-builtin-rule-docs.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "tegami": "tsx scripts/tegami.ts",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "typecheck": "turbo typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.19.1",
    "@nelsonlaidev/oxfmt-config": "0.3.1",
    "@nelsonlaidev/oxlint-config": "1.1.0",
    "@nelsonlaidev/typescript-config": "1.2.3",
    "@types/node": "catalog:dev",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2001",
    "p-limit": "7.3.2",
    "tegami": "1.5.0",
    "tinyexec": "1.3.1",
    "tsx": "4.23.13",
    "turbo": "2.10.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2"
}
